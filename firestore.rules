rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isMemberAfter(groupId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isAdmin(groupId) {
      return isMember(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function memberPlayerId(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.playerId;
    }

    match /groups/{groupId} {
      allow get, list: if isMember(groupId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin(groupId)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      match /members/{memberId} {
        allow get, list: if isMember(groupId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && (
            (getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              && request.resource.data.role == 'admin')
            || (
              request.resource.data.role == 'member'
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.invitationCode))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.invitationCode)).data.groupId == groupId
            )
          );
        allow update, delete: if isAdmin(groupId);
      }

      match /players/{playerId} {
        allow read: if isMember(groupId);
        allow create: if isMemberAfter(groupId)
          && (request.resource.data.userId == request.auth.uid || isAdmin(groupId));
        allow update: if isAdmin(groupId) || (
          isMember(groupId) && resource.data.userId == request.auth.uid
        );
        allow delete: if isAdmin(groupId);
      }

      match /sessions/{sessionId} {
        allow read: if isMember(groupId);
        allow create: if isAdmin(groupId) && request.resource.data.groupId == groupId;
        allow update: if isAdmin(groupId) || (
          isMember(groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.phase == resource.data.phase
          && request.resource.data.date == resource.data.date
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'buyIns', 'paidByPlayer'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([memberPlayerId(groupId)])
          && request.resource.data.buyIns.diff(resource.data.buyIns).affectedKeys().hasOnly([memberPlayerId(groupId)])
          && request.resource.data.paidByPlayer.diff(resource.data.paidByPlayer).affectedKeys().hasOnly([memberPlayerId(groupId)])
          && selfPlayerChangeIsValid(groupId, resource.data, request.resource.data)
          && selfBuyInChangeIsValid(groupId, resource.data, request.resource.data)
        );
        allow delete: if isAdmin(groupId);
      }
    }

    function selfPlayerChangeIsValid(groupId, oldSession, newSession) {
      let playerId = memberPlayerId(groupId);
      let oldPlayers = oldSession.players;
      let newPlayers = newSession.players;
      return (
          !oldPlayers.keys().hasAny([playerId])
          && !newPlayers.keys().hasAny([playerId])
        )
        || (
          newPlayers.keys().hasAny([playerId])
          && oldPlayers.keys().hasAny([playerId])
          && newPlayers[playerId].playerId == oldPlayers[playerId].playerId
          && newPlayers[playerId].joinedAt == oldPlayers[playerId].joinedAt
          && newPlayers[playerId].diff(oldPlayers[playerId]).affectedKeys().hasOnly(['cashOut', 'cashOutAt'])
        )
        || (
          newPlayers.keys().hasAny([playerId])
          && !oldPlayers.keys().hasAny([playerId])
          && newPlayers[playerId].playerId == playerId
          && newPlayers[playerId].cashOut == null
          && newPlayers[playerId].cashOutAt == null
        );
    }

    function selfBuyInChangeIsValid(groupId, oldSession, newSession) {
      let playerId = memberPlayerId(groupId);
      let oldBuyIns = oldSession.buyIns.get(playerId, []);
      let newBuyIns = newSession.buyIns.get(playerId, []);
      return (newBuyIns.size() == oldBuyIns.size() && newBuyIns.hasAll(oldBuyIns))
        || (
          newBuyIns.size() == oldBuyIns.size() + 1
          && newBuyIns.hasAll(oldBuyIns)
          && newBuyIns[newBuyIns.size() - 1].playerId == playerId
          && newBuyIns[newBuyIns.size() - 1].amount is number
          && newBuyIns[newBuyIns.size() - 1].amount > 0
        );
    }

    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.inviteCode == inviteCode
        && (
          getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
          || isAdmin(request.resource.data.groupId)
        );
      allow update, delete: if isAdmin(resource.data.groupId);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
